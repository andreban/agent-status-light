{
  "status-light": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "agent-status-light --port /dev/ttyACM0"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agent-status-light --port /dev/ttyACM0"
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "agent-status-light --port /dev/ttyACM0"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agent-status-light --port /dev/ttyACM0"
      }
    ]
  }
}
